# =============================================================================
# EdgeCloud Orchestrator — Rebuild Environment Configuration
# =============================================================================
# This file contains placeholders for values that change per AWS account.
# DO NOT commit real values to git.
#
# How to generate:
#   1. Run Terraform apply
#   2. Run: bash infra/rebuild/scripts/00-collect-outputs.sh
#   3. Or manually fill in from Terraform outputs and AWS CLI queries
# =============================================================================

# --- AWS Account ---
AWS_REGION=ap-south-1
AWS_PROFILE=edgecloud
PROJECT_NAME=edgecloud
AWS_ACCOUNT_ID=<RUN: aws sts get-caller-identity --query Account --output text>

# --- EC2 Instances ---
CLOUD_PUBLIC_IP=<RUN: terraform output -raw ec2_public_ip>
CLOUD_PRIVATE_IP=<RUN: terraform output -raw ec2_private_ip || aws ec2 describe-instances --filters Name=tag:Name,Values=edgecloud-cloud-node --query 'Reservations[].Instances[].PrivateIpAddress' --output text>
CLOUD_INSTANCE_ID=<RUN: terraform output -raw ec2_instance_id>
EDGE_PUBLIC_IP=<RUN: terraform output -raw edge_node_public_ip>
EDGE_PRIVATE_IP=<RUN: terraform output -raw edge_node_private_ip>
EDGE_INSTANCE_ID=<RUN: terraform output -raw edge_node_instance_id>

# --- ECR ---
ECR_REGISTRY=<RUN: echo ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com>

# --- KubeEdge ---
KUBEEDGE_VERSION=v1.23.1
K3S_VERSION=v1.32.13+k3s1

# --- Node Names ---
EDGE_NODE_NAME=edge-ec2-node
CLOUD_NODE_NAME=<RUN: aws ec2 describe-instances --instance-ids ${CLOUD_INSTANCE_ID} --query 'Reservations[].Instances[].PrivateDnsName' --output text>

# --- Application ---
EDGE_NAMESPACE=edgecloud
