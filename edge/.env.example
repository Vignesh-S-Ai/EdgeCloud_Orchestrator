# --------------------------------------------------------------------------
# Edge Node configuration template.
# Copy to edge/.env and adjust. Every value is optional - defaults shown.
# --------------------------------------------------------------------------

# Service
EDGE_SERVICE_NAME=edge-node
EDGE_VERSION=0.1.0
EDGE_HOST=0.0.0.0
EDGE_PORT=8000
EDGE_LOG_LEVEL=INFO

# Camera source: webcam index, RTSP URL, or local video file.
EDGE_CAMERA_SOURCE=0
# Optional: webcam | rtsp | file (auto-detected when omitted)
# EDGE_CAMERA_TYPE=webcam
EDGE_CAMERA_WIDTH=640
EDGE_CAMERA_HEIGHT=480
EDGE_CAMERA_FPS=30
EDGE_CAMERA_OPEN_TIMEOUT_SEC=5.0

# YOLO model
EDGE_MODEL_PATH=yolov8n.pt
EDGE_MODEL_CONFIDENCE=0.5
EDGE_MODEL_IOU=0.45
EDGE_MODEL_DEVICE=cpu
EDGE_MODEL_IMG_SIZE=640
# Comma separated COCO class ids, e.g. "0,2,5" (empty = all classes)
# EDGE_MODEL_CLASSES=

# Monitoring
EDGE_MONITOR_INTERVAL_SEC=1.0

# Local scheduler / decision engine
EDGE_SCHEDULER_ENABLED=true
EDGE_SCHEDULER_CPU_THRESHOLD=80
EDGE_SCHEDULER_RAM_THRESHOLD=80
EDGE_SCHEDULER_PRIORITY=medium

# API limits
EDGE_MAX_UPLOAD_BYTES=209715200
EDGE_MAX_DETECT_BYTES=10485760
