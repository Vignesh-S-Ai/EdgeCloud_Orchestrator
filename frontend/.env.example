# ---------------------------------------------------------------------------
# CLOUD-13 dashboard - backend endpoints
# Copy to `.env` (or `.env.local`) and adjust. Every value has a safe default.
# ---------------------------------------------------------------------------

# Where the dashboard gets its data:
#   demo -> clearly-labelled mock service (default, no backend required)
#   live -> the FastAPI services below
VITE_DATA_MODE=demo

# Orchestrator (single entry point) - uvicorn orchestrator.api.app:create_app --factory --port 8003
VITE_ORCHESTRATOR_URL=http://localhost:8003

# Edge node - uvicorn edge.api.app:create_app --factory --port 8000
# In K3s the browser-reachable URL is the KubeEdge ServiceBus route, e.g.
# http://<cloud-public-ip>:9443/edge-ec2-node/edgecloud
VITE_EDGE_URL=http://localhost:8000

# Cloud node - uvicorn cloud.api.app:create_app --factory --port 8001
VITE_CLOUD_URL=http://localhost:8001

# Scheduler / decision engine - uvicorn scheduler.api.app:create_app --factory --port 8002
VITE_SCHEDULER_URL=http://localhost:8002

# Dashboard refresh interval in milliseconds (health + metrics polling)
VITE_REFRESH_INTERVAL_MS=5000

# Set to true to proxy API calls through the Vite dev server instead of
# calling the FastAPI services directly (they already allow every origin).
VITE_USE_PROXY=false
