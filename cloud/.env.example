# --------------------------------------------------------------------------
# Cloud Node configuration template.
# Copy to cloud/.env and adjust. Every value is optional - defaults shown.
# --------------------------------------------------------------------------

# Service
CLOUD_SERVICE_NAME=cloud-node
CLOUD_VERSION=0.1.0
CLOUD_HOST=0.0.0.0
CLOUD_PORT=8001
CLOUD_LOG_LEVEL=INFO

# YOLO model (same vocabulary as the Edge Node EDGE_MODEL_*)
CLOUD_MODEL_PATH=yolov8n.pt
CLOUD_MODEL_CONFIDENCE=0.5
CLOUD_MODEL_IOU=0.45
CLOUD_MODEL_DEVICE=cpu
CLOUD_MODEL_IMG_SIZE=640
# Comma separated COCO class ids, e.g. "0,2,5" (empty = all classes)
# CLOUD_MODEL_CLASSES=

# Monitoring
CLOUD_MONITOR_INTERVAL_SEC=1.0

# API limits
CLOUD_MAX_INFER_BYTES=10485760
